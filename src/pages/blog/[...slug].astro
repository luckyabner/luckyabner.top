---
import { type CollectionEntry, getCollection } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import {
	getPreferredBlogPost,
	groupBlogPosts,
	type BlogLanguage,
} from '../../lib/blog';

export async function getStaticPaths() {
	const groups = groupBlogPosts(await getCollection('blog'));

	return groups.flatMap((group) => {
		const post = getPreferredBlogPost(group);
		if (!post) return [];

		const language: BlogLanguage = post === group.en ? 'en' : 'zh';
		const alternateHref =
			group.en && group.zh ? `/zh/blog/${group.slug}/` : undefined;

		return [{
			params: { slug: group.slug },
			props: { post, language, alternateHref },
		}];
	});
}

interface Props {
	post: CollectionEntry<'blog'>;
	language: BlogLanguage;
	alternateHref?: string;
}

const { post, language, alternateHref } = Astro.props;
const { Content } = await post.render();
---
<BlogPost
	{...post.data}
	language={language}
	alternateHref={alternateHref}
>
	<Content />
</BlogPost>
