---
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout
	title="Blog"
	description='My thoughts and experiences on everything.'
	image='/og/og-blog.png'
>
	<section class="content-page" aria-labelledby="blog-title">
		<header class="page-heading">
			<h1 id="blog-title">Blog</h1>
			<p>Notes on software, ideas, and things I’m learning.</p>
		</header>

		<ol class="post-list">
			{
				posts.map((post, index) => (
					<li class="post-list-item">
						<a
							href={`/blog/${post.slug}/`}
							class="post-row"
							aria-label={`Read ${post.data.title}`}
						>
							<span class="row-number" aria-hidden="true">
								{String(index + 1).padStart(2, '0')}
							</span>
							<span class="post-row-copy">
								<h2>{post.data.title}</h2>
								<span class="row-date">
								<FormattedDate date={post.data.date} />
								</span>
							</span>
							<span class="row-arrow" aria-hidden="true">↗</span>
						</a>
					</li>
				))
			}
		</ol>
	</section>
</Layout>
