---
import { getCollection } from "astro:content";
import FormattedDate from "../../components/FormattedDate.astro";
import Layout from "../../layouts/Layout.astro";
import { getPreferredBlogPost, getReadingTime, groupBlogPosts } from "../../lib/blog";

const posts = groupBlogPosts(await getCollection("blog"))
	.map((group) => {
		const post = getPreferredBlogPost(group);
		if (!post) return null;

		return {
			post,
			slug: group.slug,
			isEnglish: post === group.en,
			readingTime: getReadingTime(post.body),
		};
	})
	.filter((item) => item !== null)
	.sort((a, b) => b.post.data.date.valueOf() - a.post.data.date.valueOf());
---

<Layout
	title="Blog — Abner"
	description="Notes on software, ideas, and things I’m learning."
	image="/og/og-blog.png"
	alternateHref="/zh/blog/"
	alternateLang="zh-CN"
	xDefaultHref="/blog/"
>
	<section class="content-page" aria-labelledby="blog-title">
		<header class="page-heading">
			<h1 id="blog-title">Blog</h1>
			<p>Notes on software, ideas, and things I’m learning.</p>
			<a class="page-language-link" href="/zh/blog/" lang="zh-CN">
				中文文章 <span aria-hidden="true">→</span>
			</a>
		</header>

		<ol class="post-list">
			{
				posts.map((post, index) => (
					<li class="post-list-item">
						<a
							href={`/blog/${post.slug}/`}
							class="post-row"
							aria-labelledby={`post-title-${index}${post.isEnglish ? ` post-lang-${index}` : ""}`}
						>
							<span class="post-row-copy">
								<h2 id={`post-title-${index}`} lang={post.isEnglish ? "en" : "zh-CN"}>
									{post.post.data.title}
								</h2>
								<span class="row-date">
									<FormattedDate date={post.post.data.date} locale="en-US" />
									<span aria-hidden="true"> · </span>{post.readingTime} min
									{post.isEnglish && (
										<>
											<span aria-hidden="true"> · </span>
											<span
												id={`post-lang-${index}`}
												class="language-mark"
												lang="en"
												aria-label="English"
											>
												EN
											</span>
										</>
									)}
								</span>
							</span>
						</a>
					</li>
				))
			}
		</ol>
	</section>
</Layout>
