---
import { ArrowUpRight } from "@lucide/astro";
import { getCollection } from "astro:content";
import FormattedDate from "../../components/FormattedDate.astro";
import Layout from "../../layouts/Layout.astro";
import { getPreferredBlogPost, groupBlogPosts } from "../../lib/blog";

const posts = groupBlogPosts(await getCollection("blog"))
	.map((group) => {
		const post = getPreferredBlogPost(group);
		if (!post) return null;

		return {
			post,
			slug: group.slug,
			isEnglish: post === group.en,
		};
	})
	.filter((item) => item !== null)
	.sort((a, b) => b.post.data.date.valueOf() - a.post.data.date.valueOf());
---

<Layout
	title="Blog"
	description="My thoughts and experiences on everything."
	image="/og/og-blog.png"
>
	<section class="content-page" aria-labelledby="blog-title">
		<header class="page-heading">
			<h1 id="blog-title">Blog</h1>
			<p>Notes on software, ideas, and things I’m learning.</p>
		</header>

		<ol class="post-list">
			{
				posts.map((post, index) => (
					<li class="post-list-item">
						<a
							href={`/blog/${post.slug}/`}
							class="post-row"
							aria-label={`Read ${post.post.data.title}`}
						>
							<span class="row-number" aria-hidden="true">
								{String(index + 1).padStart(2, "0")}
							</span>
							<span class="post-row-copy">
								<h2>
									{post.post.data.title}
									{post.isEnglish && (
										<span
											class="language-mark"
											aria-label="English"
										>
											en
										</span>
									)}
								</h2>
								<span class="row-date">
									<FormattedDate date={post.post.data.date} />
								</span>
							</span>
							<ArrowUpRight
								size={17}
								stroke-width={1.5}
								class="row-arrow"
								aria-hidden="true"
							/>
						</a>
					</li>
				))
			}
		</ol>
	</section>
</Layout>
