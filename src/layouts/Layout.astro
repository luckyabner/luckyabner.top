---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

interface Props {
  title: string;
  description: string;
  image?: string;
  lang?: string;
  type?: "website" | "article";
  publishedTime?: string;
  alternateHref?: string;
  alternateLang?: string;
  xDefaultHref?: string;
  wide?: boolean;
}

const {
  title,
  description,
  image,
  lang = "en",
  type = "website",
  publishedTime,
  alternateHref,
  alternateLang,
  xDefaultHref,
  wide = false,
} = Astro.props;
---

<html lang={lang} class="bg-background text-text">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      lang={lang}
      type={type}
      publishedTime={publishedTime}
      alternateHref={alternateHref}
      alternateLang={alternateLang}
      xDefaultHref={xDefaultHref}
    />
  </head>

  <body class="site-shell">
    <a class="skip-link" href="#main-content" lang="en">Skip to content</a>
    <Header />
    <main id="main-content" class:list={["site-main", { "site-main-wide": wide }]}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
