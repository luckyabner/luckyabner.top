---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "../styles/global.css";

import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description: string;
  image?: string;
  alternateHref?: string;
  alternateLang?: string;
  xDefaultHref?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
  title,
  description,
  image = "/og/og.png",
  alternateHref,
  alternateLang,
  xDefaultHref,
} = Astro.props;
---

<script is:inline>
  (() => {
    document.documentElement.classList.add("js");

    let storedTheme = null;
    try {
      storedTheme = localStorage.getItem("theme");
    } catch {
      // Keep the system preference when storage is unavailable.
    }

    const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
    const isDark = storedTheme === "dark" || (!storedTheme && prefersDark);
    document.documentElement.classList.toggle("dark", isDark);
  })();
</script>

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta
  name="viewport"
  content="width=device-width,initial-scale=1,viewport-fit=cover"
/>
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

<!-- Font preloads -->
<!-- <link rel="preload" href="/fonts/atkinson-regular.woff" as="font" type="font/woff" crossorigin /> -->
<!-- <link rel="preload" href="/fonts/atkinson-bold.woff" as="font" type="font/woff" crossorigin /> -->

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />
{
  alternateHref && alternateLang && (
    <link
      rel="alternate"
      hreflang={alternateLang}
      href={new URL(alternateHref, Astro.site)}
    />
  )
}
{
  xDefaultHref && (
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(xDefaultHref, Astro.site)}
    />
  )
}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />

<!-- rss -->
<link
  rel="alternate"
  type="application/rss+xml"
  title="Subscribe to my blog"
  href={new URL("/rss.xml", Astro.url)}
/>

<ClientRouter />
