---
import { Moon, Sun } from "@lucide/astro";
---

<button
  id="themeToggle"
  class="theme-toggle"
  type="button"
  aria-label="Switch color theme"
  title="Switch color theme"
>
  <Sun size={16} strokeWidth={1.5} class="block dark:hidden" />
  <Moon size={15} strokeWidth={1.5} class="hidden dark:block" />
</button>

<script src="../scripts/theme.ts"></script>
