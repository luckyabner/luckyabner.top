---
import { Moon, Sun } from "@lucide/astro";
---

<button
  id="themeToggle"
  class="theme-toggle"
  type="button"
  aria-label="Switch to dark theme"
  aria-pressed="false"
  title="Switch to dark theme"
>
  <Sun size={16} stroke-width={1.5} aria-hidden="true" class="block dark:hidden" />
  <Moon size={15} stroke-width={1.5} aria-hidden="true" class="hidden dark:block" />
</button>

<script src="../scripts/theme.ts"></script>
