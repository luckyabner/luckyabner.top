---
import { Image } from "astro:assets";
import HeaderLink from "./HeaderLink.astro";
import ThemeIcon from "./ThemeIcon.astro";
---

<header class="site-header">
  <HeaderLink href="/" title="Home" class="brand-link" aria-label="Abner — Home">
    <Image
      src="/logo-light.png"
      width={80}
      height={80}
      class="brand-mark block dark:hidden"
      alt=""
      loading="eager"
    />
    <Image
      src="/logo-dark.png"
      width={80}
      height={80}
      class="brand-mark hidden dark:block"
      alt=""
      loading="eager"
    />
  </HeaderLink>
  <nav class="site-nav" aria-label="Primary navigation">
    <HeaderLink href="/blog" title="Blog">Blog</HeaderLink>
    <HeaderLink href="/projects" title="Projects">Projects</HeaderLink>
    <ThemeIcon />
  </nav>
</header>
