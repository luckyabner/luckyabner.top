---
interface Props {
	date: Date;
	locale?: string;
}

const { date, locale = 'en-US' } = Astro.props;
const isChinese = locale.startsWith('zh');
const formatted = date.toLocaleDateString(locale, {
	year: 'numeric',
	month: isChinese ? 'long' : 'short',
	day: 'numeric',
	timeZone: 'UTC',
});
---

<time datetime={date.toISOString()}>{formatted}</time>
